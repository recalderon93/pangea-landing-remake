#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "\n Checking code with husky 🐺\n"

echo " ⏳ Running lint-staged (format & lint staged files)..."
echo ""

# Run lint-staged (much faster - only checks staged files)
if npx lint-staged; then
  echo ""
  echo "  ✅ Prettier passed."
  echo "  ✅ ESLint passed."
  echo ""
  echo "\033[0;32mGood job mate!\033[0m"
  echo ""
  echo "Committing Code..."
  echo ""
  exit 0
else
  echo ""
  echo "\033[0;31m🚨  Due to an error in one of the checks, git commit attempt was aborted\033[0m"
  echo ""
  echo "💡 For more information about lint errors, run 'npm run format' or 'npm run lint'"
  echo "💡 To auto-fix issues, run 'npm run format:fix' and 'npm run lint:fix'"
  echo ""
  exit 1
fi
