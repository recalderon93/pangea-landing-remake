---
import "@styles/global.css";
import "@fontsource/poppins";
import MainLayout from "@layouts/MainLayout.astro";
import { buttonStyles } from "@styles/button";
import FormWrapper from "@features/ContactUs/FormWrapper";
---

<MainLayout locale="en" fillHeader>
  <FormWrapper containerClassName="flex flex-col flex-1 items-center">
    <div class="flex flex-col items-center pt-20">
      <h1 class="heading-1 mb-6 text-white">Thank You!</h1>
      <p class="h5 mb-16 px-8 text-center text-white">
        We appreciate you reaching out to us. Our team will get back to you
        shortly.
      </p>
      <a href="/" class={buttonStyles({ variant: "accent" })}>Return to Home</a>
    </div>
  </FormWrapper>
</MainLayout>
