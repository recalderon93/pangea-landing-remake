---
import "@styles/global.css";
import MainLayout from "@layouts/MainLayout.astro";
import { buttonStyles } from "@styles/button";
import FormWrapper from "@features/ContactUs/FormWrapper";
import { Routes } from "@/constants/routes";
import { t, type Locale } from "@/i18n";

type Props = {
  locale: Locale;
};

const locale: Locale = "es";
---

<MainLayout locale={locale} fillHeader>
  <FormWrapper containerClassName="flex flex-col flex-1 items-center">
    <div class="flex flex-col items-center pt-20">
      <h1 class="heading-1 mb-6 text-white">
        {t(locale, "contact-us.success.title")}
      </h1>
      <p class="h5 mb-16 px-8 text-center text-white">
        {t(locale, "contact-us.success.caption")}
      </p>
      <a href={Routes[locale].home} class={buttonStyles({ variant: "accent" })}
        >{t(locale, "contact-us.success.back-home")}</a
      >
    </div>
  </FormWrapper>
</MainLayout>
