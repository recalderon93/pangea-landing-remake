---
import "@styles/global.css";
import HeroSection from "@features/OurWork/HeroSection.astro";
import MainLayout from "@layouts/MainLayout.astro";
import Projects from "@features/Projects/Projects.astro";
import FAQs from "@features/FAQs/FAQs.astro";
import Testimonials from "@features/Testimonials/Testimonials";
import UnlockPotentialBanner from "@features/Banners/UnlockPotentialBanner.astro";
import { featureFlags } from "@constants/featureFlags";
import { Routes } from "@constants/routes";

if (!featureFlags.showOurWork) {
  return Astro.redirect(Routes.es.home);
}
---

<MainLayout locale="es" fillHeader>
  <HeroSection locale="es" />
  <Projects locale="es" showHeader={false} />
  <FAQs locale="es" />
  <Testimonials client:load locale="es" />
  <UnlockPotentialBanner locale="es" />
</MainLayout>
