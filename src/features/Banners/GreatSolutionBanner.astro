---
import { buttonStyles } from "@styles/button";
import { cn } from "@styles/classNameMerge";
import { t, type Locale } from "@/i18n";

export interface Props {
  locale: Locale;
}

const { locale }: Props = Astro.props;
---

<div class="sm:12 px-8 py-10 md:px-0">
  <div
    class="bg-pattern flex flex-col items-center gap-y-12 rounded-[24px] bg-teal-400 px-9 py-6 sm:gap-y-16 sm:py-8 md:px-12 md:py-12 lg:items-start lg:px-16 lg:py-16">
    <div
      class="grow-0 rounded-full bg-gradient-to-r from-[rgba(251,251,251,0.30)] to-[rgba(251,251,251,0.20)] px-6 py-2 text-xs leading-[150%] text-white shadow-[-2px_4px_4px_0_rgba(0,0,0,0.10)] backdrop-blur-[1px] sm:text-base">
      <p>{t(locale, "banners.great-solution.badge")}</p>
    </div>
    <div
      class="flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-end lg:gap-30">
      <h2
        class="text-white-50 max-w-[780px] text-[30px] leading-10 sm:text-[56px] sm:leading-[64px]">
        {t(locale, "banners.great-solution.title-1")}
        <span class="text-green-200">
          {t(locale, "banners.great-solution.title-2")}
        </span>
      </h2>

      <a
        href="/contact-us"
        class={cn([buttonStyles({ variant: "accent" }), "flex-none"])}
        >{t(locale, "banners.great-solution.cta")}
      </a>
    </div>
  </div>
</div>
