---
import { t, type Locale } from "@/i18n";
import HeroTextInputWrapper from "./HeroTextInputWrapper";

interface Props {
  locale: Locale;
}
const { locale }: Props = Astro.props;
---

<div
  class="bg-pattern flex h-screen max-h-[720px] min-h-[540px] w-full flex-col items-center gap-10 rounded-b-3xl bg-teal-400 pt-28 sm:pt-36 md:pt-40">
  <h1 class="w-[85%] text-center text-white lg:max-w-[800px]">
    {t(locale, "hero.title-1")}<br class="hidden sm:block" />
    <span class="text-green-200">{t(locale, "hero.title-2")}</span>{
      t(locale, "hero.title-3")
    }
  </h1>
  <p
    class="text-white-50 paragraph-1 w-[70%] text-center lg:max-w-[580px]"
    data-testid="hero-description">
    {t(locale, "hero.caption")}
  </p>
  <div class="pt-4">
    <HeroTextInputWrapper locale={locale} client:load />
  </div>
</div>
