---
import { t, type Locale } from "@/i18n";
import SolutionsSlider from "./ServicesSlider";

interface Props {
  locale: Locale;
}

const { locale }: Props = Astro.props;
---

<div class="flex flex-col gap-y-8 px-4 pt-10 pb-2 sm:px-6 md:px-10 lg:px-14">
  <div
    class="flex-col items-start justify-between py-8 sm:flex sm:py-10 lg:flex-row lg:items-baseline">
    <h2
      class="section-title max-w-[520px] grow pb-8 whitespace-pre-line text-teal-400">
      {t(locale, "landing.solutions.title")}
    </h2>
    <h3
      class="section-side-subtitle text-shade-400 max-w-[400px] lg:max-w-[380px] lg:text-right">
      {t(locale, "landing.solutions.caption")}
    </h3>
  </div>
</div>
<SolutionsSlider client:load locale={locale} />
<div class="flex w-full items-center justify-center px-12 pt-16">
  <div
    class="flex max-w-full shrink-0 grow-0 items-center justify-around rounded-lg bg-neutral-100 px-[44px] py-3 text-teal-500 sm:rounded-2xl sm:py-4">
    <p class="text-center text-xs leading-5 sm:text-xl sm:leading-8">
      {t(locale, "landing.solutions.tag")}
    </p>
  </div>
</div>
