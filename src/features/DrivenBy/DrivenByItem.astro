---
import CheckIcon from "@components/icons/Check";
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props as Props;
---

<div
  class="flex w-[80vw] max-w-[450px] gap-3 rounded-2xl px-5 py-3 hover:bg-[linear-gradient(102deg,_rgba(251,251,251,0.2)_0%,_rgba(251,251,251,0.05)_100%)] hover:shadow-[-2px_4px_4px_0_rgba(0,0,0,0.1)] hover:backdrop-blur-[10px] sm:w-[60vw] sm:gap-4 md:gap-5 md:rounded-3xl lg:w-[40vw] 2xl:w-[25vw]">
  <div class="pt-2">
    <CheckIcon />
  </div>
  <div class="flex flex-col gap-1">
    <h3
      class="text-[18.75px] leading-[30px] font-semibold whitespace-pre-line text-white">
      {title}
    </h3>
    <p
      class="max-w-[220px] text-[12px] leading-[20px] whitespace-pre-line text-white sm:max-w-[280px] sm:text-[16px] sm:leading-[24px]">
      {description}
    </p>
  </div>
</div>
