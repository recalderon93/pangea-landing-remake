---
import { t, type Locale } from "@/i18n";
import FounderList from "./FounderList.tsx";
import { cva } from "class-variance-authority";
import { cn } from "../../styles/classNameMerge";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const titleClassName =
  "text-[30px] leading-10 text-teal-400 md:whitespace-normal whitespace-pre-line md:text-[56px] md:leading-[64px]";
---

<div class="px-8 py-20 md:px-20 md:py-34">
  <h2 class={cn(titleClassName, "")}>
    {t(locale, "who-we-are.founders.title")}
  </h2>
  <FounderList locale={locale} client:load />
  <div class="flex flex-col gap-6 md:gap-16">
    <h2 class={cn(titleClassName, "max-w-[674px]")}>
      {t(locale, "who-we-are.founders.secondary-title")}
    </h2>
    <p
      class="text-shade-400 max-w-[590px] text-base font-medium md:text-[30px] md:leading-10">
      {t(locale, "who-we-are.founders.quote")}
    </p>
  </div>
</div>
