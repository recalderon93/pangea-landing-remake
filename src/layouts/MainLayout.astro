---
import "@styles/global.css";
import "@fontsource/poppins/latin-400.css";
import "@fontsource/poppins/latin-500.css";
import "@fontsource/poppins/latin-600.css";
import "@fontsource/poppins/latin-700.css";
import "@fontsource/poppins/latin-800.css";
import type { Locale } from "@/i18n";
import Header from "@features/Header/Header";
import Footer from "@features/Footer/Footer.astro";

export interface Props {
  locale: Locale;
  fillHeader?: boolean;
  title?: string;
}
const { locale, title = "Pangea Landing", fillHeader = false } = Astro.props;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body
    class="relative flex flex-col"
    style="padding-bottom: env(safe-area-inset-bottom);">
    <Header client:load lang={locale} fillHeader={fillHeader} />
    <div class="flex-grow pb-10 2xl:mx-auto 2xl:w-[1536px]">
      <slot />
    </div>
    <Footer lang={locale} />
  </body>
</html>
